# Copy this file to .env for local development. Never commit real credentials.
AWS_REGION=ap-southeast-1
CV_BUCKET_NAME=
CV_RESULTS_TABLE=cv-evaluations

# AI provider: "openai", "bedrock", or "mock" (offline demo, no cloud calls).
AI_PROVIDER=bedrock

# Bedrock: for ap-southeast-1 use an inference profile, not a direct model ID.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# OpenAI platform (used when AI_PROVIDER=openai). Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set only for Azure OpenAI or an OpenAI-compatible gateway.
OPENAI_BASE_URL=
